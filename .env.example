# Authentication Proxy Configuration
AUTH_PROXY_URL=http://localhost:3000

# AI Provider API Keys (Can be configured here or in UI -> Agent Settings)
# Google Gemini API Key (Recommended for standard agent loop):
GEMINI_API_KEY=

# OpenAI Compatible API Key (For OpenAI, DeepSeek, Groq, OpenRouter):
OPENAI_API_KEY=

# Local Ollama Base URL (Default: http://localhost:11434/v1 - No API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1
